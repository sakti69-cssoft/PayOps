{
  "name": "payops-genai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "api": "node --env-file-if-exists=.env --import tsx apps/api/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/main.ts",
    "simulator": "node --env-file-if-exists=.env --import tsx apps/simulator/main.ts",
    "dashboard": "vite --config apps/dashboard/vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:fault": "node --env-file-if-exists=.env --import tsx scripts/fault.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/database/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "setup": "node scripts/setup.mjs",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "integration": "node --import tsx scripts/integration.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mqtt": "5.16.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
